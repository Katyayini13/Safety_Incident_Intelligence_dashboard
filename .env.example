# Local frontend/API values for development. Vite's dev server uses its proxy by default.
VITE_API_URL=http://127.0.0.1:8000

# Backend allowed browser origins, comma-separated. On Railway replace with
# the exact public frontend origin, e.g. https://your-frontend.up.railway.app.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Railway supplies PORT automatically; do not commit or hard-code it.
